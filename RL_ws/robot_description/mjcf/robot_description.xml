<mujoco model="petbot">
  <!-- 网格仍在 CAD 世界系（毫米→米）。geom quat 把 CAD(X左,Y上,Z前) 转到 MuJoCo(X前,Y左,Z上)。
       base_link 浮动基；lower_body 固连为结构树根。
       质量：头 0.43 kg、身体 0.30 kg、左右车架各 0.36 kg；整机 1.65254 kg。
       左右车架质心较原匀质模型沿局部 -X 后移 0.028 m；惯量由 STL 和质量/质心约束估计。
       自碰开启（contype/conaffinity bit0）；轮子仅与地面碰撞（bit1），不与机体/其他轮碰撞。
       力矩关节限位见各 joint range。后轮 velocity，其余 motor。
       摩擦为经验值（无实测）：关节 frictionloss 为干摩擦；geom friction 为对地接触。
       前轮滑动摩擦为 0.1，priority=1 确保不被地面较大的摩擦覆盖。 -->
  <compiler angle="radian" meshdir="../meshes" autolimits="true"/>

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <geom condim="3" friction="0.6 0.01 0.001"/>
    <joint type="hinge" limited="true" range="-3.14159 3.14159" damping="0.038" armature="9.6e-5" frictionloss="0.02"/>
    <site size="0.004" rgba="1 0 1 0.85"/>
    <default class="robot">
      <geom type="mesh" quat="0.5 0.5 0.5 0.5" contype="1" conaffinity="1"/>
    </default>
    <default class="wheel">
      <joint limited="false" damping="0.0005" armature="2.4e-5" stiffness="0" frictionloss="0.008"/>
    </default>
    <default class="wheel_geom">
      <geom type="mesh" quat="0.5 0.5 0.5 0.5" contype="2" conaffinity="0" friction="1.4 0.008 0.0004"/>
    </default>
  </default>

  <asset>
    <material name="mat_lower_body" rgba="0.40 0.58 0.78 0.85"/>
    <material name="mat_head" rgba="0.95 0.90 0.78 0.85"/>
    <material name="mat_ear" rgba="0.95 0.52 0.22 0.85"/>
    <material name="mat_frame" rgba="0.40 0.62 0.38 0.85"/>
    <material name="mat_front_wheel" rgba="0.92 0.72 0.12 0.85"/>
    <material name="mat_rear_wheel" rgba="0.62 0.35 0.82 0.85"/>

    <mesh name="lower_body" file="下身.STL" scale="0.001 0.001 0.001"/>
    <mesh name="head" file="头.STL" scale="0.001 0.001 0.001"/>
    <mesh name="left_ear" file="左耳.STL" scale="0.001 0.001 0.001"/>
    <mesh name="right_ear" file="右耳.STL" scale="0.001 0.001 0.001"/>
    <mesh name="left_frame" file="左车架.STL" scale="0.001 0.001 0.001"/>
    <mesh name="right_frame" file="右车架.STL" scale="0.001 0.001 0.001"/>
    <mesh name="left_front_wheel" file="左前轮.STL" scale="0.001 0.001 0.001"/>
    <mesh name="right_front_wheel" file="右前轮.STL" scale="0.001 0.001 0.001"/>
    <mesh name="left_rear_wheel" file="左后轮.STL" scale="0.001 0.001 0.001"/>
    <mesh name="right_rear_wheel" file="右后轮.STL" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <body name="base_link" pos="0 0 0.08481" childclass="robot">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="0.00048" diaginertia="4.8e-7 4.8e-7 4.8e-7"/>
      <site name="com_base_link" pos="0 0 0"/>

      <body name="lower_body">
        <inertial pos="0.00012 0.00000 -0.00300" mass="0.30000"
          fullinertia="2.566274893e-04 1.816530030e-04 3.136772490e-04 2.063149332e-10 2.136503618e-05 -8.397627701e-11"/>
        <geom name="lower_body" mesh="lower_body" pos="-0.09979 -0.12300 -0.08566" material="mat_lower_body"/>
        <site name="com_lower_body" pos="0.00012 0 -0.00300"/>
        <site name="imu" pos="0 0 0" size="0.006" rgba="0 0.85 0.9 0.9"/>

        <body name="head" pos="0.01602 0.00000 0.01922">
          <inertial pos="0.02989 0.00000 0.04757" mass="0.43000"
            fullinertia="5.110981512e-04 5.912446866e-04 5.103463001e-04 2.609287249e-11 1.580471223e-05 -5.382046433e-10"/>
          <joint name="head" axis="0.45399 0 0.89101" range="-1.3 1.3" damping="0.048" frictionloss="0.025"/>
          <geom name="head" mesh="head" pos="-0.11581 -0.12300 -0.10488" material="mat_head"/>
          <site name="com_head" pos="0.02989 0 0.04757"/>

          <body name="left_ear" pos="0.02900 0.04854 0.06940">
            <inertial pos="-0.03455 0.00790 0.01776" mass="0.02431"
              fullinertia="5.967527e-06 1.875674e-05 1.475898e-05 1.511340e-06 5.357314e-06 -1.017235e-07"/>
            <joint name="left_ear" axis="0 0.95630 0.29237" range="-1 3" damping="0.010" frictionloss="0.008"/>
            <geom name="left_ear" mesh="left_ear" pos="-0.14481 -0.17154 -0.17428" material="mat_ear"/>
            <site name="com_left_ear" pos="-0.03455 0.00790 0.01776"/>
          </body>
          <body name="right_ear" pos="0.02982 -0.04879 0.06866">
            <inertial pos="-0.03537 -0.00765 0.01850" mass="0.02431"
              fullinertia="5.967426e-06 1.875795e-05 1.476049e-05 -1.510867e-06 5.357280e-06 1.015322e-07"/>
            <joint name="right_ear" axis="0 0.95630 -0.29237" range="-1 3" damping="0.010" frictionloss="0.008"/>
            <geom name="right_ear" mesh="right_ear" pos="-0.14563 -0.07421 -0.17354" material="mat_ear"/>
            <site name="com_right_ear" pos="-0.03537 -0.00765 0.01850"/>
          </body>
        </body>

        <body name="left_frame" pos="0.01000 0.05152 -0.00807">
          <inertial pos="-0.01783 0.02857 -0.01539" mass="0.36000"
            fullinertia="1.624720694e-04 5.932145503e-04 5.355919901e-04 -5.964792329e-05 -4.693248378e-05 -3.969971130e-06"/>
          <joint name="left_frame" axis="0 1 0" range="-1 1.2" damping="0.072" frictionloss="0.04"/>
          <geom name="left_frame" mesh="left_frame" pos="-0.10979 -0.17452 -0.07759" material="mat_frame"/>
          <site name="com_left_frame" pos="-0.01783 0.02857 -0.01539"/>

          <body name="left_front_wheel" pos="0.10021 0.01052 -0.03166">
            <inertial pos="0 0 0" mass="0.02638"
              fullinertia="2.171806e-05 4.179199e-05 2.187174e-05 0 0 1.756238e-06"/>
            <joint name="left_front_wheel" class="wheel" axis="0 0.99619 0.08716" frictionloss="0.004"/>
            <geom name="left_front_wheel" class="wheel_geom" mesh="left_front_wheel"
              pos="-0.21000 -0.18504 -0.04593" material="mat_front_wheel"
              friction="0.1 0.008 0.0004" priority="1"/>
            <site name="com_left_front_wheel" pos="0 0 0"/>
          </body>
          <body name="left_rear_wheel" pos="-0.07979 -0.00152 -0.04538">
            <inertial pos="0 0 0" mass="0.05034"
              fullinertia="1.509888e-05 2.264717e-05 1.509888e-05 0 0 0"/>
            <joint name="left_rear_wheel" class="wheel" axis="0 1 0" frictionloss="0.012"/>
            <geom name="left_rear_wheel" class="wheel_geom" mesh="left_rear_wheel"
              pos="-0.03000 -0.17300 -0.03221" material="mat_rear_wheel"/>
            <site name="com_left_rear_wheel" pos="0 0 0"/>
          </body>
        </body>

        <body name="right_frame" pos="0.01000 -0.05152 -0.00807">
          <inertial pos="-0.01783 -0.02857 -0.01539" mass="0.36000"
            fullinertia="1.624746755e-04 5.931969994e-04 5.355748628e-04 5.964482501e-05 -4.693898255e-05 3.969301948e-06"/>
          <joint name="right_frame" axis="0 1 0" range="-1 1.2" damping="0.072" frictionloss="0.04"/>
          <geom name="right_frame" mesh="right_frame" pos="-0.10979 -0.07148 -0.07759" material="mat_frame"/>
          <site name="com_right_frame" pos="-0.01783 -0.02857 -0.01539"/>

          <body name="right_front_wheel" pos="0.10021 -0.01052 -0.03166">
            <inertial pos="0 0 0" mass="0.02638"
              fullinertia="2.171797e-05 4.179181e-05 2.187164e-05 0 0 -1.756231e-06"/>
            <joint name="right_front_wheel" class="wheel" axis="0 0.99619 -0.08716" frictionloss="0.004"/>
            <geom name="right_front_wheel" class="wheel_geom" mesh="right_front_wheel"
              pos="-0.21000 -0.06096 -0.04593" material="mat_front_wheel"
              friction="0.1 0.008 0.0004" priority="1"/>
            <site name="com_right_front_wheel" pos="0 0 0"/>
          </body>
          <body name="right_rear_wheel" pos="-0.07979 0.00152 -0.04538">
            <inertial pos="0 0 0" mass="0.05034"
              fullinertia="1.509887e-05 2.264716e-05 1.509887e-05 0 0 0"/>
            <joint name="right_rear_wheel" class="wheel" axis="0 1 0" frictionloss="0.012"/>
            <geom name="right_rear_wheel" class="wheel_geom" mesh="right_rear_wheel"
              pos="-0.03000 -0.07300 -0.03221" material="mat_rear_wheel"/>
            <site name="com_right_rear_wheel" pos="0 0 0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- 驱动器参数沿用原 1.2 kg 版本的设置；本次质量校正未修改驱动力限幅。ctrl 力矩为 N·m，后轮 ctrl 为 rad/s -->
    <motor name="head" joint="head" gear="1" ctrlrange="-0.72 0.72" forcerange="-0.72 0.72"/>
    <motor name="left_ear" joint="left_ear" gear="1" ctrlrange="-0.10 0.10" forcerange="-0.10 0.10"/>
    <motor name="right_ear" joint="right_ear" gear="1" ctrlrange="-0.10 0.10" forcerange="-0.10 0.10"/>
    <motor name="left_frame" joint="left_frame" gear="1" ctrlrange="-1.20 1.20" forcerange="-1.20 1.20"/>
    <motor name="right_frame" joint="right_frame" gear="1" ctrlrange="-1.20 1.20" forcerange="-1.20 1.20"/>
    <velocity name="left_rear_wheel" joint="left_rear_wheel" kv="0.14" ctrlrange="-25 25" forcerange="-0.38 0.38"/>
    <velocity name="right_rear_wheel" joint="right_rear_wheel" kv="0.14" ctrlrange="-25 25" forcerange="-0.38 0.38"/>
  </actuator>

  <sensor>
    <accelerometer name="imu_accel" site="imu"/>
    <gyro name="imu_gyro" site="imu"/>
  </sensor>
</mujoco>
