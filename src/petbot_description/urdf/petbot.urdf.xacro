<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="petbot">

  <!-- ===================== 几何参数 ===================== -->
  <!-- 主体：前后长 20cm × 宽 15cm × 高 15cm；质量加大且重心压低防翻 -->
  <xacro:property name="base_length" value="0.20"/>
  <xacro:property name="base_width" value="0.15"/>
  <xacro:property name="base_height" value="0.15"/>
  <xacro:property name="base_mass" value="15.0"/>

  <xacro:property name="wheel_radius" value="0.04"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="wheel_mass" value="0.5"/>
  <!-- 支撑三角形尽量铺开 -->
  <xacro:property name="wheel_separation" value="0.22"/>
  <xacro:property name="wheel_x_offset" value="-0.08"/>
  <xacro:property name="base_z" value="${wheel_radius}"/>
  <!-- 视觉厢体上移；惯性中心贴近轮轴高度，降低翻车力矩 -->
  <xacro:property name="base_z_offset" value="${base_height/2 - 0.02}"/>
  <xacro:property name="base_com_z" value="0.015"/>

  <xacro:property name="caster_radius" value="0.02"/>
  <xacro:property name="caster_mass" value="0.12"/>
  <xacro:property name="caster_x" value="${base_length/2 - 0.005}"/>

  <!-- Nebula280MIPI：头部（前面中间靠上），轻微上仰 -->
  <xacro:property name="nebula280_x" value="${base_length/2 - 0.01}"/>
  <xacro:property name="nebula280_z" value="${base_z_offset + base_height/2 - 0.008}"/>
  <xacro:property name="nebula280_pitch" value="0.10"/>

  <xacro:macro name="box_inertia" params="m l w h">
    <inertia
      ixx="${(m/12.0) * (w*w + h*h)}" ixy="0.0" ixz="0.0"
      iyy="${(m/12.0) * (l*l + h*h)}" iyz="0.0"
      izz="${(m/12.0) * (l*l + w*w)}"/>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia
      ixx="${(m/12.0) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
      iyy="${(m/12.0) * (3*r*r + h*h)}" iyz="0.0"
      izz="${(m/2.0) * r*r}"/>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertia
      ixx="${(2.0/5.0) * m * r*r}" ixy="0.0" ixz="0.0"
      iyy="${(2.0/5.0) * m * r*r}" iyz="0.0"
      izz="${(2.0/5.0) * m * r*r}"/>
  </xacro:macro>

  <material name="blue"><color rgba="0.15 0.40 0.80 1.0"/></material>
  <material name="black"><color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="gray"><color rgba="0.55 0.55 0.55 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_z_offset}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_z_offset}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <!-- 重心靠近轮轴高度，视觉仍用较高厢体 -->
      <origin xyz="0 0 ${base_com_z}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <xacro:box_inertia m="${base_mass}" l="${base_length}" w="${base_width}" h="${base_height * 0.35}"/>
    </inertial>
  </link>

  <xacro:macro name="drive_wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${wheel_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${wheel_x_offset} ${y_reflect * wheel_separation / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.2" friction="0.2"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left" y_reflect="1"/>
  <xacro:drive_wheel prefix="right" y_reflect="-1"/>

  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${caster_mass}"/>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 ${-base_z + caster_radius}" rpy="0 0 0"/>
  </joint>

  <!-- 传感器：六轴 IMU + Nebula280MIPI -->
  <xacro:include filename="$(find petbot_description)/urdf/sensors/imu_6axis.urdf.xacro"/>
  <xacro:imu_6axis parent="base_link">
    <!-- 靠近底盘几何中心、略高于厢体底板 -->
    <origin xyz="0 0 ${base_z_offset - base_height/2 + 0.01}" rpy="0 0 0"/>
  </xacro:imu_6axis>

  <xacro:include filename="$(find petbot_description)/urdf/sensors/nebula280_mipi.urdf.xacro"/>
  <xacro:nebula280_mipi parent="base_link">
    <origin xyz="${nebula280_x} 0 ${nebula280_z}" rpy="0 ${nebula280_pitch} 0"/>
  </xacro:nebula280_mipi>

  <xacro:include filename="$(find petbot_description)/urdf/petbot.gazebo.xacro"/>

</robot>
