<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="petbot">

  <!-- ===================== 几何参数 ===================== -->
  <xacro:property name="base_length" value="0.28"/>
  <xacro:property name="base_width" value="0.20"/>
  <xacro:property name="base_height" value="0.08"/>
  <xacro:property name="base_mass" value="8.0"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.8"/>
  <xacro:property name="wheel_separation" value="0.22"/>
  <!-- 驱动轮略靠后，提高稳定性 -->
  <xacro:property name="wheel_x_offset" value="-0.02"/>
  <xacro:property name="base_z" value="${wheel_radius}"/>

  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_mass" value="0.15"/>
  <xacro:property name="caster_x" value="0.10"/>

  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="lidar_mass" value="0.15"/>
  <xacro:property name="lidar_z" value="${base_height / 2 + lidar_height / 2 + 0.01}"/>

  <xacro:macro name="box_inertia" params="m l w h">
    <inertia
      ixx="${(m/12.0) * (w*w + h*h)}" ixy="0.0" ixz="0.0"
      iyy="${(m/12.0) * (l*l + h*h)}" iyz="0.0"
      izz="${(m/12.0) * (l*l + w*w)}"/>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia
      ixx="${(m/12.0) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
      iyy="${(m/12.0) * (3*r*r + h*h)}" iyz="0.0"
      izz="${(m/2.0) * r*r}"/>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertia
      ixx="${(2.0/5.0) * m * r*r}" ixy="0.0" ixz="0.0"
      iyy="${(2.0/5.0) * m * r*r}" iyz="0.0"
      izz="${(2.0/5.0) * m * r*r}"/>
  </xacro:macro>

  <material name="blue"><color rgba="0.15 0.40 0.80 1.0"/></material>
  <material name="black"><color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="gray"><color rgba="0.55 0.55 0.55 1.0"/></material>
  <material name="orange"><color rgba="0.95 0.55 0.10 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <!-- COM 略压低，减少倾覆 -->
      <origin xyz="0 0 -0.01" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <xacro:box_inertia m="${base_mass}" l="${base_length}" w="${base_width}" h="${base_height}"/>
    </inertial>
  </link>

  <xacro:macro name="drive_wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <!-- 球体碰撞接触更稳 -->
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${wheel_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <!-- 轮心与 base_link 同高（= wheel_radius），使轮缘触地 -->
      <origin xyz="${wheel_x_offset} ${y_reflect * wheel_separation / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.2" friction="0.2"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left" y_reflect="1"/>
  <xacro:drive_wheel prefix="right" y_reflect="-1"/>

  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${caster_mass}"/>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 ${-base_z + caster_radius}" rpy="0 0 0"/>
  </joint>

  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${lidar_mass}"/>
      <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.04 0 ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <xacro:include filename="$(find petbot_description)/urdf/petbot.gazebo.xacro"/>

</robot>
